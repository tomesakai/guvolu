# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，永不提交。
# 读取专用密钥：13 个 REST GET + 4 个 Private WebSocket 频道
GMO_COIN_READ_ONLY_API_KEY=""
GMO_COIN_READ_ONLY_API_SECRET=""

# 交易专用密钥：仅 5 个下单/改单/撤单端点，无任何读取能力
GMO_COIN_TRADE_API_KEY=""
GMO_COIN_TRADE_API_SECRET=""

# bitFlyer 读取专用密钥：账户资产等私有读取；不使用交易或出金权限
BITFLYER_READ_ONLY_API_KEY=""
BITFLYER_READ_ONLY_API_SECRET=""

# 运行模式：dry-run | live   （缺省必须为 dry-run，见 SKILLS.md 铁律 T-04）
GUVOLU_MODE="dry-run"

# 查询服务：近窗逐笔端点秒窗上限
GUVOLU_RECENT_TRADES_MAX_SECONDS="600"

# 查询服务：当日瓦片增量刷新间隔秒
GUVOLU_TILE_REFRESH_SECONDS="15"

# 限速自约束（R-04）：公开端 2 至 3 次每秒，私有端 10 次每秒
GUVOLU_PUBLIC_RPS="3"
GUVOLU_PRIVATE_RPS="10"
GUVOLU_BITFLYER_PRIVATE_RPS="1.5"

# 现物交易白名单（T-09），逗号分隔
GUVOLU_SPOT_WHITELIST="BTC"

# 运行时日志目录
GUVOLU_LOG_DIR="logs"

# 不可变行情与 SQLite 数据根；绝对路径可放在独立数据盘
GUVOLU_DATA_ROOT="data"

# 风控限额起步值（T-11），运行时只可调低，不得高于代码硬顶
GUVOLU_ORDER_JPY_MAX="500"
GUVOLU_DAY_JPY_MAX="2000"
GUVOLU_DAY_COUNT_MAX="50"
